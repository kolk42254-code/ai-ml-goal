# Copy this file to ".env" and fill in your own values.
# Never share your .env file or upload it to GitHub - it holds your secret keys.

# ---- AI (Google Gemini) - from https://aistudio.google.com/apikey ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Webhook safety ----
# Any secret word you choose. Type the SAME word in Meta's "Verify token" box.
VERIFY_TOKEN=choose-your-own-secret-word
# Meta app: App settings > Basic > App secret. (Same value for both if one app has WhatsApp and Instagram.)
WHATSAPP_APP_SECRET=
INSTAGRAM_APP_SECRET=

# ---- WhatsApp (Meta app > WhatsApp > API Setup) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Instagram (Meta app > Instagram > API setup with Instagram login) ----
INSTAGRAM_TOKEN=

# ---- Leave these as they are unless you know why ----
GRAPH_API_VERSION=v26.0
